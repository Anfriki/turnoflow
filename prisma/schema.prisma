// ─────────────────────────────────────────────────────────────
//  TurnoFlow — Esquema PostgreSQL (Prisma ORM)
//  Edición: Atención al Ciudadano (Ministerio / Organismo Público)
//
//  Restricciones que Prisma no puede expresar (índices parciales,
//  CHECKs) están en prisma/migrations/*/migration.sql.
//  Para cambios de esquema usá:
//     npx prisma migrate dev --create-only --name <cambio>
//  y revisá el SQL generado antes de aplicarlo (ver README).
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  OPERATOR
}

enum TicketType {
  WALK_IN
  SCHEDULED
}

/// Estado del FLUJO de atención (cola)
enum TicketStatus {
  WAITING
  CALLED
  IN_SERVICE
  ATTENDED
  ABSENT
  CANCELLED
}

/// Origen de la cédula / documento: V venezolano, E extranjero, J jurídico, G gobierno
enum IdOrigin {
  V
  E
  J
  G
}

/// Resultado de la PETICIÓN (se registra al finalizar la atención)
enum ResolutionStatus {
  RESUELTO
  EN_TRAMITE
  REMITIDO
  NO_PROCEDE
  PENDIENTE_RECAUDOS
}

/// Atención preferencial (eleva la prioridad del turno)
enum PreferentialType {
  TERCERA_EDAD
  EMBARAZADA
  DISCAPACIDAD
}

/// Sedes / oficinas de atención
model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(120)
  code      String   @unique @db.VarChar(20)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reasons      AttentionReason[]
  dependencies Dependency[]
  desks        Desk[]
  users        User[]
  tickets      Ticket[]
  counters     DailyCounter[]

  @@map("branches")
}

/// Dependencias de atención (bifurcación del tótem). Ej. MPPE:
/// Zona Educativa (ZE) y Atención al Ciudadano (OAC). Su prefijo define el código del turno.
model Dependency {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  code        String   @db.VarChar(10)
  name        String   @db.VarChar(120)
  description String?
  /// Ícono (emoji) que se muestra en el tótem
  icon        String?  @db.VarChar(8)
  /// Prefijo del turno: ZE-001, OAC-001
  prefix      String   @db.VarChar(3)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch  Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  desks   DeskDependency[]
  tickets Ticket[]

  @@unique([branchId, code])
  @@unique([branchId, prefix])
  @@map("dependencies")
}

/// Tabla maestra de motivos de atención / trámites (administrable)
model AttentionReason {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String   @map("branch_id") @db.Uuid
  /// Código administrativo, ej. "NOM-01", "JUB-02"
  code                 String   @db.VarChar(20)
  name                 String   @db.VarChar(120)
  description          String?
  /// Dirección o unidad ministerial responsable del trámite
  department           String   @db.VarChar(150)
  /// Prefijo del número de turno (N-001). Varios motivos pueden compartirlo y comparten numeración.
  prefixLetter         String   @map("prefix_letter") @db.VarChar(3)
  priorityLevel        Int      @default(0) @map("priority_level")
  estimatedDurationMin Int      @default(10) @map("estimated_duration_min")
  allowAppointments    Boolean  @default(true) @map("allow_appointments")
  isActive             Boolean  @default(true) @map("is_active")
  /// Orden de presentación en el tótem (las Direcciones se ordenan por su primer trámite)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch  Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  desks   DeskReason[]

  @@unique([branchId, code])
  @@index([branchId, isActive])
  @@map("attention_reasons")
}

/// Taquillas
model Desk {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  /// Número de taquilla (1, 2, …) → "Taquilla N° 1"
  number            Int
  /// Etiqueta administrativa, ej. "Taquilla 01"
  identifier        String   @db.VarChar(40)
  currentOperatorId String?  @unique @map("current_operator_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentOperator User?            @relation("DeskOperator", fields: [currentOperatorId], references: [id], onDelete: SetNull)
  reasons         DeskReason[]
  dependencies    DeskDependency[]
  tickets         Ticket[]

  @@unique([branchId, identifier])
  @@unique([branchId, number])
  @@map("desks")
}

/// Qué motivos atiende cada taquilla (si una taquilla no tiene filas aquí, atiende todos).
model DeskReason {
  deskId   String @map("desk_id") @db.Uuid
  reasonId String @map("reason_id") @db.Uuid

  desk   Desk            @relation(fields: [deskId], references: [id], onDelete: Cascade)
  reason AttentionReason @relation(fields: [reasonId], references: [id], onDelete: Cascade)

  @@id([deskId, reasonId])
  @@index([reasonId])
  @@map("desk_reasons")
}

/// Qué dependencias atiende cada taquilla (si una taquilla no tiene filas aquí, atiende todas).
model DeskDependency {
  deskId       String @map("desk_id") @db.Uuid
  dependencyId String @map("dependency_id") @db.Uuid

  desk       Desk       @relation(fields: [deskId], references: [id], onDelete: Cascade)
  dependency Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([deskId, dependencyId])
  @@index([dependencyId])
  @@map("desk_dependencies")
}

/// Funcionarios: operadores de taquilla, supervisores y administradores
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  role         Role     @default(OPERATOR)
  branchId     String?  @map("branch_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  desk          Desk?    @relation("DeskOperator")
  servedTickets Ticket[] @relation("TicketOperator")

  @@map("users")
}

/// Cache local de ciudadanos (alimentada por el servicio externo y por los registros del tótem)
model Citizen {
  idOrigin    IdOrigin  @map("id_origin")
  idNumber    String    @map("id_number") @db.VarChar(12)
  fullName    String    @map("full_name") @db.VarChar(150)
  /// LOCAL (cargado en tótem/taquilla), SAIME, MOCK, HTTP…
  source      String    @default("LOCAL") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastVisitAt DateTime? @map("last_visit_at") @db.Timestamptz(6)

  @@id([idOrigin, idNumber])
  @@map("citizens")
}

/// Turnos / atenciones (presenciales y citas)
model Ticket {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  reasonId         String            @map("reason_id") @db.Uuid
  /// Dependencia elegida en el tótem (null en turnos anteriores a su creación)
  dependencyId     String?           @map("dependency_id") @db.Uuid
  deskId           String?           @map("desk_id") @db.Uuid
  operatorId       String?           @map("operator_id") @db.Uuid
  ticketNumber     Int               @map("ticket_number")
  code             String            @db.VarChar(12)
  type             TicketType        @default(WALK_IN)
  scheduledAt      DateTime?         @map("scheduled_at") @db.Timestamptz(6)
  status           TicketStatus      @default(WAITING)
  /// Prioridad efectiva = prioridad del motivo + bonificación preferencial
  priorityLevel    Int               @default(0) @map("priority_level")
  preferentialType PreferentialType? @map("preferential_type")
  /// Día de negocio (en APP_TIMEZONE) al que pertenece la numeración.
  serviceDate      DateTime          @map("service_date") @db.Date
  recallCount      Int               @default(0) @map("recall_count")

  // ── Ciudadano ──
  idOrigin    IdOrigin @map("id_origin")
  idNumber    String   @map("id_number") @db.VarChar(12)
  citizenName String   @map("citizen_name") @db.VarChar(150)

  // ── Asignación (instantánea al momento del llamado, para auditoría) ──
  deskNumber   Int?    @map("desk_number")
  operatorName String? @map("operator_name") @db.VarChar(120)

  // ── Resolución de la petición ──
  resolutionStatus      ResolutionStatus? @map("resolution_status")
  resolutionNotes       String?           @map("resolution_notes")
  destinationDepartment String?           @map("destination_department") @db.VarChar(150)

  // ── Marcas de tiempo ──
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)
  calledAt    DateTime? @map("called_at") @db.Timestamptz(6)
  /// Inicio de la atención en taquilla (attended_at)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  // ── Desglose temporal para reportería (en APP_TIMEZONE) ──
  year      Int
  month     Int
  day       Int
  hour      Int
  /// ISO-8601: 1 = lunes … 7 = domingo
  dayOfWeek Int @map("day_of_week")

  // ── Duraciones precalculadas (segundos) ──
  waitSeconds    Int? @map("wait_seconds")
  serviceSeconds Int? @map("service_seconds")

  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reason     AttentionReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  dependency Dependency?     @relation(fields: [dependencyId], references: [id], onDelete: Restrict)
  desk       Desk?           @relation(fields: [deskId], references: [id], onDelete: SetNull)
  operator   User?           @relation("TicketOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  /// Un código no se repite dentro del mismo día de negocio y sede
  @@unique([branchId, code, serviceDate], map: "uq_tickets_daily_code")
  /// Índice de despacho para "Llamar siguiente"
  @@index([branchId, status, priorityLevel(sort: Desc), createdAt(sort: Asc)], map: "idx_tickets_dispatch")
  @@index([branchId, serviceDate], map: "idx_tickets_branch_day")
  @@index([deskId, status], map: "idx_tickets_desk_status")
  @@index([idOrigin, idNumber, serviceDate], map: "idx_tickets_citizen")
  @@index([branchId, year, month, day], map: "idx_tickets_report_date")
  @@index([reasonId, serviceDate], map: "idx_tickets_reason_day")
  @@index([dependencyId, serviceDate], map: "idx_tickets_dependency_day")
  @@index([operatorId, serviceDate], map: "idx_tickets_operator_day")
  @@index([branchId, resolutionStatus], map: "idx_tickets_resolution")
  @@map("tickets")
}

/// Correlativo diario por prefijo y sede (reinicio automático por fecha).
model DailyCounter {
  branchId    String   @map("branch_id") @db.Uuid
  prefix      String   @db.VarChar(3)
  serviceDate DateTime @map("service_date") @db.Date
  lastNumber  Int      @default(0) @map("last_number")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, prefix, serviceDate])
  @@map("daily_counters")
}
