# ─────────────────────────────────────────────────────────────
#  TurnoFlow — variables de entorno
#  Copiá este archivo a `.env` y ajustá los valores.
# ─────────────────────────────────────────────────────────────

# Entorno: development | production
NODE_ENV=development

# Puerto HTTP del servidor (API + frontend + Socket.io)
PORT=3000

# Conexión a PostgreSQL:  postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=public
DATABASE_URL=postgresql://turnos:turnos@localhost:5432/turnos_db?schema=public

# Secreto para firmar los JWT. En producción usá una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+caracteres
JWT_EXPIRES_IN=12h

# Zona horaria de negocio (IANA). Define cuándo "empieza el día" para
# reiniciar la numeración A-001 y para los horarios de citas.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Máximo de turnos/citas emitidos por minuto desde una misma IP (sólo en producción).
# Si varios tótems salen a Internet por la misma IP (NAT), subilo.
RATE_LIMIT_PUBLIC_PER_MIN=120

# Orígenes permitidos para CORS (separados por coma). Vacío = mismo origen.
CORS_ORIGINS=

# ── Overrides opcionales de marca (tienen prioridad sobre brand.config.js) ──
# COMPANY_NAME="Banco Regional"
# COMPANY_TAGLINE="Atención al Cliente"
# BRAND_PRIMARY_COLOR=#0F4C81
# BRAND_SECONDARY_COLOR=#00A6A6
