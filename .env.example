# ─────────────────────────────────────────────────────────────
#  TurnoFlow — variables de entorno
#  Copie este archivo a `.env` y ajuste los valores.
# ─────────────────────────────────────────────────────────────

# Entorno: development | production
NODE_ENV=development

# Puerto HTTP del servidor (API + frontend + Socket.io)
PORT=3000

# Conexión a PostgreSQL:  postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=public
DATABASE_URL=postgresql://turnos:turnos@localhost:5432/turnos_db?schema=public

# Secreto para firmar los JWT. En producción use una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+caracteres
JWT_EXPIRES_IN=12h

# Zona horaria del organismo (IANA). Define cuándo "empieza el día" (reinicio
# de la numeración N-001), los horarios de citas y el desglose año/mes/día/hora.
APP_TIMEZONE=America/Caracas

# Máximo de turnos/citas emitidos por minuto desde una misma IP (sólo en producción).
# Si varios tótems salen a Internet por la misma IP (NAT), súbalo.
RATE_LIMIT_PUBLIC_PER_MIN=120

# Orígenes permitidos para CORS (separados por coma). Vacío = mismo origen.
CORS_ORIGINS=

# ── Consulta de cédulas (autocompletado del nombre) ──────────
# mock = registro simulado (desarrollo) · http = servicio externo real · none = sólo cache local
CITIZEN_LOOKUP_PROVIDER=mock
# Sólo para "http": endpoint que recibe ?nacionalidad=V&cedula=12345678
# CITIZEN_LOOKUP_URL=https://servicio-identidad.interno/api/ciudadanos
# CITIZEN_LOOKUP_TOKEN=
CITIZEN_LOOKUP_TIMEOUT_MS=3000
# Días que un nombre del servicio externo se reutiliza desde la cache sin volver a consultar
CITIZEN_CACHE_TTL_DAYS=180
# true = el tótem recibe el nombre enmascarado ("M**** G*******") en la consulta pública
CITIZEN_LOOKUP_MASK_PUBLIC=false
# Consultas públicas de cédula por minuto y por IP (sólo en producción)
RATE_LIMIT_LOOKUP_PER_MIN=30

# ── Overrides opcionales de marca (tienen prioridad sobre brand.config.js) ──
# COMPANY_NAME="Ministerio de Gestión Pública"
# COMPANY_TAGLINE="Oficina de Atención al Ciudadano"
# BRAND_PRIMARY_COLOR=#0B3D91
# BRAND_SECONDARY_COLOR=#C8102E
